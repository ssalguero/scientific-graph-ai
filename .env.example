# Scientific Graph AI - production configuration template (placeholders only).
# Copy to `.env.local` for local development. Do not commit real secrets.

# Supabase (client-visible by design - Next.js NEXT_PUBLIC_* bundling)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Workspace diagnostics overlay (off by default). Set to exactly "1" to enable.
# NEXT_PUBLIC_WORKSPACE_DIAGNOSTICS=1

# Optional conversational generation provider (server-only). Both required.
# Without them, Preguntar stays visible but does not simulate generation.
# SGAI_GENERATION_URL=https://your-provider.example/v1/chat/completions
# SGAI_GENERATION_API_KEY=your-server-key
# SGAI_GENERATION_MODEL=default
